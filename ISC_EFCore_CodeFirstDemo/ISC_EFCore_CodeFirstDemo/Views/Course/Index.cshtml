@model IEnumerable<ISC_EFCore_CodeFirstDemo.Models.Course>

@{
    ViewData["Title"] = "Index";
}

<h1>List of Courses</h1>

<p>
    <a asp-action="Create" class="btn btn-success">Create New Course</a>
</p>

@if(TempData["Message"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show my-3" role="alert">
        <strong>Message!</strong> @TempData["Message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<table class="table table-primary table-striped">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.CourseName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CourseDuration)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CourseFee)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(model => item.CourseName)
                </td>
                <td>
                    @Html.DisplayFor(model => item.CourseDuration)
                </td>
                <td>
                    @Html.DisplayFor(model => item.CourseFee)
                </td>
                <td>
                    <a asp-action="Edit" class="btn btn-primary" asp-route-id="@item.CourseId">Edit</a> |
                    <a asp-action="Details" class="btn btn-info" asp-route-id="@item.CourseId">Details</a> |
                    <a asp-action="Delete" class="btn btn-danger" asp-route-id="@item.CourseId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
