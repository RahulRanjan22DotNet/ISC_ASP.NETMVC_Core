@model IEnumerable<ISC_ScaffoldingDemo.Models.Employee>

@{
    ViewData["Title"] = "Index";
}

<h1 class="p-2 bg-success my-2 text-white">Employee Listing Page</h1>

<p>
    <a class="btn btn-info my-2" asp-action="Create">Add New Employee</a>
</p>
<table class="table table-success table-striped">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Designation)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DOB)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Salary)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(model => item.Name)
                </td>
                <td>
                    @Html.DisplayFor(model => item.Designation)
                </td>
                <td>
                    @Html.DisplayFor(model => item.DOB)
                </td>
                <td>
                    @Html.DisplayFor(model => item.Salary)
                </td>
                <td>
                    <a asp-action="Edit" class="btn btn-sm btn-primary" asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="Details" class=" btn btn-sm btn-success" asp-route-id="@item.Id">Details</a> |
                    <a asp-action="Delete" class="btn btn-sm btn-danger" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
