@{
}

<h1 class="p-2 bg-primary text-white">Calculator</h1>

<h1>@ViewBag.Result</h1>

<div class="container">
    <div class="row d-flex justify-content-center">
        <div class="col-sm-12 col-md-6 p-4 bg-body-secondary">
            <form method="post">
                <label class="form-label">First Number</label>
                <input type="text" class="form-control" name="firstNumber" required />
                <label class="form-label">Second Number</label>
                <input type="text" class="form-control" name="secondNumber" required />
                <select class="form-select mt-2" name="operation" required>
                    <option value="">Select Operation</option>
                    <option value="add">Add</option>
                    <option value="sub">Subtract</option>
                    <option value="mul">Multiply</option>
                    <option value="div">Divide</option>
                </select>
                <button type="submit" class="btn btn-primary mt-2">Calculate</button>
            </form>
        </div>
    </div>
</div>