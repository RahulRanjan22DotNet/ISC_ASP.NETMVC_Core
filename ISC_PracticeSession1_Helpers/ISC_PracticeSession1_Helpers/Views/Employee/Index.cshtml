@{
}
@model Employee

<h1 class="p-2 bg-primary text-white">Employee Information Form</h1>
<div class="container-fluid">
    <div class="row">
        <div class="col-lg-6 p-3 border border-2 bg-body-secondary">
            @using(Html.BeginForm("ShowData", "Employee", FormMethod.Post))
            {
                <div>
                    @Html.LabelFor(x => x.Name, new { @class = "form-label" })
                    @Html.TextBoxFor(x => x.Name, new { @class = "form-control" })
                </div>
                <div>
                    @Html.LabelFor(x => x.DOB, new { @class = "form-label" })
                    @Html.TextBoxFor(x => x.DOB, new { @class = "form-control", @type="date"})
                </div>
                <div>
                    @Html.LabelFor(x => x.Designation, new { @class = "form-label" })
                    @Html.DropDownListFor(x => x.Designation, new SelectList(new[] { "Software Developer", "Senior Software Developer", "Team Lead", "Manager", "IT Head" }), "-- Select Designation --", new { @class = "form-select" })
                </div>
                <div>
                    @Html.LabelFor(x => x.Salary, new { @class = "form-label" })
                    @Html.TextBoxFor(x => x.Salary, new { @class = "form-control", @type = "number" })
                </div>
                <div class="mt-2">

                </div>
                <input type="submit" value="Submit" class="btn btn-success" />
            }
        </div>
    </div>
    

</div>