@using System.Collections
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}

@model IEnumerable<Employee>

<h1 class="p-3 justify-content-center bg-success text-white"> Details of Employee</h1>
<table class="table table-striped table-success">
    <tr>
        <th> Employee ID:</th>
        <th> Employee Name:</th>
        <th> Gender:</th>
        <th> Department:</th>
        <th> DOB:</th>
        <th> DOJ:</th>

    </tr>
   @foreach (var emp in Model)
    {
        <tr>
            <td>@emp.EmpId</td>
            <td>@emp.EmpName</td>
            <td>@emp.Gender</td>
            <td>@emp.Department</td>
            <td>@emp.DOB</td>
            <td>@emp.DOJ</td>
        </tr>
    }
</table>