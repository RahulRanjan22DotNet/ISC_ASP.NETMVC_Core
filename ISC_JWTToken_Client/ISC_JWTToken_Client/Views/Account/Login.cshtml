@model LoginViewModel

@{
    ViewData["Title"] = "Sign in";
}

<div class="register-page">
    <div class="register-card">
        <div class="row g-0">
            <div class="col-lg-5 register-intro p-4 p-md-5 text-white">
                <div class="brand-mark mb-5">ISC</div>
                <p class="eyebrow">WELCOME BACK</p>
                <h1 class="display-6 fw-bold mb-3">Good to see you again.</h1>
                <p class="intro-copy mb-5">Sign in securely to continue where you left off and access everything you need.</p>
                <div class="d-flex align-items-center gap-3 intro-feature">
                    <span class="feature-icon"><i class="bi bi-shield-check" aria-hidden="true"></i></span>
                    <span>Secure JWT authentication</span>
                </div>
                <div class="d-flex align-items-center gap-3 intro-feature">
                    <span class="feature-icon"><i class="bi bi-lightning-charge" aria-hidden="true"></i></span>
                    <span>Fast and effortless access</span>
                </div>
            </div>
            <div class="col-lg-7 bg-white p-4 p-md-5">
                <p class="eyebrow text-primary mb-2">SIGN IN</p>
                <h2 class="h3 fw-bold mb-2">Welcome back</h2>
                <p class="text-secondary mb-4">Enter your credentials to access your account.</p>
                <form asp-action="Login" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    <div class="mb-3">
                        <label asp-for="UserName" class="form-label"></label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-white"><i class="bi bi-person" aria-hidden="true"></i></span>
                            <input asp-for="UserName" class="form-control" placeholder="Enter your user name" autocomplete="username" />
                        </div>
                        <span asp-validation-for="UserName" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-white"><i class="bi bi-lock" aria-hidden="true"></i></span>
                            <input asp-for="Password" class="form-control" placeholder="Enter your password" autocomplete="current-password" />
                            <button class="btn btn-outline-secondary password-toggle" type="button" aria-label="Show password" data-target="Password">
                                <i class="bi bi-eye" aria-hidden="true"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="rememberMe" />
                            <label class="form-check-label small text-secondary" for="rememberMe">Remember me</label>
                        </div>
                        <a href="#" class="small fw-semibold">Forgot password?</a>
                    </div>
                    <button type="submit" class="btn btn-primary btn-sm w-100 mt-4">Sign in <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i></button>
                    <p class="text-center text-secondary small mt-4 mb-0">Don't have an account? <a asp-controller="Account" asp-action="Register" class="fw-semibold">Create one</a></p>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll('.password-toggle').forEach(button => {
            button.addEventListener('click', () => {
                const input = document.getElementById(button.dataset.target);
                const icon = button.querySelector('i');
                const isPassword = input.type === 'password';
                input.type = isPassword ? 'text' : 'password';
                icon.classList.toggle('bi-eye', !isPassword);
                icon.classList.toggle('bi-eye-slash', isPassword);
                button.setAttribute('aria-label', isPassword ? 'Hide password' : 'Show password');
            });
        });
    </script>
}